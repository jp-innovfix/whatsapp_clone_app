rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function innovfixOrgId() {
      return 'innovfix';
    }

    function signedIn() {
      return request.auth != null;
    }

    function memberProfilePath(orgId, uid) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(uid);
    }

    function isActiveEmployee(orgId) {
      return signedIn()
        && orgId == innovfixOrgId()
        && request.auth.token.orgId == orgId
        && exists(memberProfilePath(orgId, request.auth.uid))
        && get(memberProfilePath(orgId, request.auth.uid)).data.active == true;
    }

    function isInnovfixEmployee() {
      return isActiveEmployee(innovfixOrgId());
    }

    function conversationPath(conversationId) {
      return /databases/$(database)/documents/conversations/$(conversationId);
    }

    function conversationMemberPath(conversationId, uid) {
      return /databases/$(database)/documents/conversations/$(conversationId)/members/$(uid);
    }

    function messagePath(conversationId, messageId) {
      return /databases/$(database)/documents/conversations/$(conversationId)/messages/$(messageId);
    }

    function isConversationMember(conversationId) {
      return isInnovfixEmployee()
        && exists(conversationPath(conversationId))
        && get(conversationPath(conversationId)).data.orgId == innovfixOrgId()
        && get(conversationPath(conversationId)).data.memberIds is list
        && request.auth.uid in get(conversationPath(conversationId)).data.memberIds
        && exists(conversationMemberPath(conversationId, request.auth.uid));
    }

    function isUuidV7(value) {
      return value is string
        && value.matches('^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$');
    }

    function validMemberProfile(data) {
      return data.keys().hasAll([
          'email',
          'displayName',
          'role',
          'active',
          'avatarKey',
          'notificationPreference',
          'lastSeenAt',
          'activeUntil',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'email',
          'displayName',
          'role',
          'active',
          'avatarKey',
          'notificationPreference',
          'lastSeenAt',
          'activeUntil',
          'createdAt',
          'updatedAt'
        ])
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 100
        && data.role in ['ADMIN', 'MEMBER']
        && data.active is bool
        && (data.avatarKey == null
          || (data.avatarKey is string && data.avatarKey.size() <= 256))
        && data.notificationPreference in ['ALL', 'NONE']
        && (data.lastSeenAt == null || data.lastSeenAt is timestamp)
        && (data.activeUntil == null || data.activeUntil is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validOwnProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return validMemberProfile(request.resource.data)
        && changed.hasOnly([
          'notificationPreference',
          'lastSeenAt',
          'activeUntil',
          'updatedAt'
        ])
        && changed.hasAll(['updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (!changed.hasAny(['lastSeenAt'])
          || request.resource.data.lastSeenAt == request.time)
        && (!changed.hasAny(['activeUntil'])
          || request.resource.data.activeUntil == null
          || (request.resource.data.activeUntil >= request.time
            && request.resource.data.activeUntil <= request.time + duration.value(120, 's')));
    }

    function validDevice(data, installationId) {
      return data.keys().hasAll([
          'installationId',
          'token',
          'platform',
          'enabled',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'installationId',
          'token',
          'platform',
          'enabled',
          'createdAt',
          'updatedAt'
        ])
        && data.installationId == installationId
        && data.installationId is string
        && data.installationId.size() > 0
        && data.installationId.size() <= 128
        && data.token is string
        && data.token.size() > 0
        && data.token.size() <= 4096
        && data.platform == 'ANDROID'
        && data.enabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validInbox(data, conversationId) {
      return data.keys().hasAll([
          'conversationId',
          'orgId',
          'conversationType',
          'title',
          'lastMessageId',
          'lastMessagePreview',
          'lastMessageSenderId',
          'lastMessageAt',
          'unreadCount',
          'muted',
          'pinned',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'conversationId',
          'orgId',
          'conversationType',
          'title',
          'lastMessageId',
          'lastMessagePreview',
          'lastMessageSenderId',
          'lastMessageAt',
          'unreadCount',
          'muted',
          'pinned',
          'archived',
          'updatedAt'
        ])
        && data.conversationId == conversationId
        && data.orgId == innovfixOrgId()
        && data.conversationType in ['DIRECT', 'GROUP']
        && data.title is string
        && data.title.size() <= 120
        && (data.lastMessageId == null || data.lastMessageId is string)
        && data.lastMessagePreview is string
        && data.lastMessagePreview.size() <= 4000
        && (data.lastMessageSenderId == null || data.lastMessageSenderId is string)
        && (data.lastMessageAt == null || data.lastMessageAt is timestamp)
        && data.unreadCount is int
        && data.unreadCount >= 0
        && data.muted is bool
        && data.pinned is bool
        && (!data.keys().hasAny(['archived']) || data.archived is bool)
        && data.updatedAt is timestamp;
    }

    function validConversationMember(data, uid) {
      return data.keys().hasAll([
          'userId',
          'role',
          'joinedAt',
          'lastDeliveredAt',
          'lastReadAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'role',
          'joinedAt',
          'lastDeliveredAt',
          'lastReadAt',
          'updatedAt'
        ])
        && data.userId == uid
        && data.role in ['ADMIN', 'MEMBER']
        && data.joinedAt is timestamp
        && data.lastDeliveredAt is timestamp
        && data.lastReadAt is timestamp
        && data.updatedAt is timestamp
        && data.lastReadAt <= data.lastDeliveredAt;
    }

    function validMessageShape(data) {
      return data.keys().hasAll([
          'senderId',
          'text',
          'clientCreatedAt',
          'serverCreatedAt',
          'replyToMessageId',
          'deletedAt',
          'schemaVersion'
        ])
        && data.keys().hasOnly([
          'senderId',
          'text',
          'clientCreatedAt',
          'serverCreatedAt',
          'replyToMessageId',
          'deletedAt',
          'schemaVersion',
          'kind',
          'storagePath',
          'fileName',
          'mimeType',
          'sizeBytes',
          'durationMillis'
        ])
        && data.senderId is string
        && data.text is string
        && data.text.size() <= 4000
        && data.clientCreatedAt is timestamp
        && data.serverCreatedAt is timestamp
        && (data.replyToMessageId == null || isUuidV7(data.replyToMessageId))
        && (data.deletedAt == null || data.deletedAt is timestamp)
        && data.schemaVersion == 1
        && (!data.keys().hasAny(['kind']) || data.kind in ['TEXT', 'IMAGE', 'DOCUMENT', 'AUDIO'])
        && (!data.keys().hasAny(['storagePath']) || data.storagePath == null || data.storagePath is string)
        && (!data.keys().hasAny(['fileName']) || data.fileName == null || (data.fileName is string && data.fileName.size() <= 240))
        && (!data.keys().hasAny(['mimeType']) || data.mimeType == null || (data.mimeType is string && data.mimeType.size() <= 120))
        && (!data.keys().hasAny(['sizeBytes']) || data.sizeBytes == null || (data.sizeBytes is int && data.sizeBytes >= 0 && data.sizeBytes <= 26214400))
        && (!data.keys().hasAny(['durationMillis']) || data.durationMillis == null || (data.durationMillis is int && data.durationMillis >= 0 && data.durationMillis <= 7200000));
    }

    function validMessageCreate(conversationId, messageId) {
      let data = request.resource.data;
      return isUuidV7(messageId)
        && validMessageShape(data)
        && data.keys().hasAny(['kind'])
        && data.senderId == request.auth.uid
        && ((data.kind == 'TEXT' && data.text.size() > 0)
          || (data.kind in ['IMAGE', 'DOCUMENT', 'AUDIO']
            && data.storagePath is string
            && data.storagePath == 'organizations/innovfix/conversations/' + conversationId + '/messages/' + messageId + '/' + data.fileName))
        && data.clientCreatedAt <= request.time + duration.value(5, 'm')
        && data.serverCreatedAt == request.time
        && data.deletedAt == null
        && (data.replyToMessageId == null
          || (data.replyToMessageId != messageId
            && exists(messagePath(conversationId, data.replyToMessageId))));
    }

    function validReaction(data, messageId, uid) {
      return data.keys().hasAll([
          'messageId',
          'userId',
          'emoji',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'messageId',
          'userId',
          'emoji',
          'createdAt',
          'updatedAt'
        ])
        && data.messageId == messageId
        && data.userId == uid
        && data.emoji in ['👍', '❤️', '😂', '😮', '😢', '🙏', '🫡', '😊']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function messageCanBeReactedTo(conversationId, messageId) {
      return exists(messagePath(conversationId, messageId))
        && get(messagePath(conversationId, messageId)).data.deletedAt == null;
    }

    function validTyping(data, uid) {
      return data.keys().hasAll(['userId', 'isTyping', 'expiresAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'isTyping', 'expiresAt', 'updatedAt'])
        && data.userId == uid
        && data.isTyping is bool
        && data.expiresAt is timestamp
        && data.updatedAt == request.time
        && ((data.isTyping == true
              && data.expiresAt >= request.time
              && data.expiresAt <= request.time + duration.value(15, 's'))
          || (data.isTyping == false && data.expiresAt <= request.time));
    }

    match /organizations/{orgId} {
      allow read: if isActiveEmployee(orgId);
      allow write: if false;

      match /members/{uid} {
        allow read: if isActiveEmployee(orgId);
        allow update: if isActiveEmployee(orgId)
          && uid == request.auth.uid
          && validOwnProfileUpdate();
        allow create, delete: if false;
      }
    }

    match /members/{uid} {
      allow read, write: if false;

      match /devices/{installationId} {
        allow read: if isInnovfixEmployee() && uid == request.auth.uid;
        allow create: if isInnovfixEmployee()
          && uid == request.auth.uid
          && validDevice(request.resource.data, installationId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isInnovfixEmployee()
          && uid == request.auth.uid
          && validDevice(request.resource.data, installationId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['token', 'enabled', 'updatedAt'])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasAll(['updatedAt'])
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if isInnovfixEmployee() && uid == request.auth.uid;
      }

      match /inbox/{conversationId} {
        allow read: if isInnovfixEmployee() && uid == request.auth.uid;
        allow update: if isInnovfixEmployee()
          && uid == request.auth.uid
          && validInbox(request.resource.data, conversationId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['muted', 'pinned', 'archived', 'updatedAt'])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasAll(['updatedAt'])
          && request.resource.data.updatedAt == request.time;
        allow create, delete: if false;
      }
    }

    match /conversations/{conversationId} {
      allow read: if isConversationMember(conversationId);
      allow create, update, delete: if false;

      match /members/{uid} {
        allow read: if isConversationMember(conversationId);
        allow update: if isConversationMember(conversationId)
          && uid == request.auth.uid
          && validConversationMember(resource.data, uid)
          && validConversationMember(request.resource.data, uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastDeliveredAt', 'lastReadAt', 'updatedAt'])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasAll(['updatedAt'])
          && request.resource.data.lastDeliveredAt >= resource.data.lastDeliveredAt
          && request.resource.data.lastReadAt >= resource.data.lastReadAt
          && request.resource.data.lastDeliveredAt <= request.time
          && request.resource.data.lastReadAt <= request.time
          && request.resource.data.updatedAt == request.time;
        allow create, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && validMessageCreate(conversationId, messageId);
        allow update: if isConversationMember(conversationId)
          && resource.data.senderId == request.auth.uid
          && resource.data.deletedAt == null
          && validMessageShape(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['text', 'deletedAt'])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasAll(['text', 'deletedAt'])
          && request.resource.data.text == ''
          && request.resource.data.deletedAt == request.time;
        allow delete: if false;
      }

      match /reactions/{reactionId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && reactionId == request.resource.data.messageId + '_' + request.auth.uid
          && validReaction(
            request.resource.data,
            request.resource.data.messageId,
            request.auth.uid
          )
          && messageCanBeReactedTo(conversationId, request.resource.data.messageId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isConversationMember(conversationId)
          && resource.data.userId == request.auth.uid
          && reactionId == resource.data.messageId + '_' + request.auth.uid
          && validReaction(
            request.resource.data,
            resource.data.messageId,
            request.auth.uid
          )
          && messageCanBeReactedTo(conversationId, resource.data.messageId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['emoji', 'updatedAt'])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasAll(['updatedAt'])
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if isConversationMember(conversationId)
          && resource.data.userId == request.auth.uid
          && reactionId == resource.data.messageId + '_' + request.auth.uid;
      }

      match /typing/{uid} {
        allow read: if isConversationMember(conversationId);
        allow create, update: if isConversationMember(conversationId)
          && uid == request.auth.uid
          && validTyping(request.resource.data, uid);
        allow delete: if isConversationMember(conversationId)
          && uid == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
