rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function activeInnovfixEmployee() {
      return request.auth != null
        && request.auth.token.orgId == 'innovfix'
        && firestore.exists(/databases/(default)/documents/organizations/innovfix/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/organizations/innovfix/members/$(request.auth.uid)).data.active == true;
    }

    function conversationMember(conversationId) {
      return activeInnovfixEmployee()
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.memberIds;
    }

    match /organizations/innovfix/conversations/{conversationId}/messages/{messageId}/{fileName} {
      allow read: if conversationMember(conversationId);
      allow write: if resource == null
        && conversationMember(conversationId)
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
